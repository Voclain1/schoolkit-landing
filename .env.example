# Resend (https://resend.com)
# API key with contacts + email send access.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret for the /api/webhooks/resend endpoint.
# Generated by `node scripts/setup-resend-webhook.mjs`, or from the Resend
# dashboard under Webhooks > (your webhook) > Signing Secret.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Distributed rate limiting for POST /api/pioneer (server-side only).
# Create an Upstash Redis database and copy its REST API credentials. The
# endpoint fails closed with HTTP 503 when either value is missing/unavailable.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Google Analytics 4 (https://analytics.google.com)
# Measurement ID of the SchoolKit web data stream. Public by design: it is
# embedded in the page, so it is NEXT_PUBLIC_. Leave it unset locally and
# analytics stays off entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
