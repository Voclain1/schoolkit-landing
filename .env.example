# Resend (https://resend.com)
# API key with contacts + email send access.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret for the /api/webhooks/resend endpoint.
# Generated by `node scripts/setup-resend-webhook.mjs`, or from the Resend
# dashboard under Webhooks > (your webhook) > Signing Secret.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of the product demo recording shown on /demo.
# Falls back to /videos/schoolkit-demo.mp4 (served from public/) when unset.
NEXT_PUBLIC_DEMO_VIDEO_URL=https://cdn.example.com/schoolkit-demo.mp4
# Optional poster frame shown before the video loads.
NEXT_PUBLIC_DEMO_VIDEO_POSTER=https://cdn.example.com/schoolkit-demo-poster.jpg
